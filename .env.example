# LLM Configuration (Alibaba DashScope OpenAI-compatible)
# 获取API Key: https://dashscope.console.aliyun.com/
OPENAI_API_KEY=sk-your-dashscope-api-key-here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-turbo

# Agent Configuration
AGENT_PORT=8000

# MQTT Broker
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# Redis (optional, system falls back to in-memory if unavailable)
REDIS_URL=redis://redis:6379/0

# Hybrid RAG Service
# Real RAG API (生产环境): POST {BASE_URL}{PATH}
#   Payload: {"query": "...", "session_id": "...", "item_names": ["致享"], "is_stream": false}
# Mock API (测试/fallback): POST /v1/hybrid-search
# 
# Docker Desktop Mac用户连接宿主机RAG服务：
#   HYBRID_RAG_BASE_URL=http://host.docker.internal:8001
#   HYBRID_RAG_PATH=/query/hybrid_rerank
# 
# Linux用户连接宿主机RAG服务：
#   HYBRID_RAG_BASE_URL=http://172.17.0.1:8001
#   HYBRID_RAG_PATH=/query/hybrid_rerank
#   （注意：127.0.0.1在容器内指向容器自己，不是宿主机）
# 
# Mock fallback（默认）：
HYBRID_RAG_BASE_URL=http://mock_rag:8081
HYBRID_RAG_PATH=/query/hybrid_rerank
HYBRID_RAG_API_KEY=

# Mock Vehicle Configuration
# PRD v1.7: nav_arrived is optional (default false) - only for demo purposes
MOCK_ENABLE_NAV_ARRIVED=false

# 备注：
# - 不要提交真实的API Key到仓库
# - 本地开发时复制此文件为 .env 并填入真实值
# - docker-compose 会自动读取 .env 文件
# - 如果不配置 OPENAI_API_KEY，系统会使用规则式规划fallback
# - MOCK_ENABLE_NAV_ARRIVED: 设为true可模拟延迟到达事件（8秒后），默认false（不发送nav_arrived）
