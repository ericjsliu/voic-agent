# Smart Cockpit Voice Agent - Environment Configuration

# ==================== Database ====================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# For containers, use service name (postgres) instead of localhost
DATABASE_URL=postgresql://cockpit:cockpit@postgres:5432/cockpit_agent

# ==================== Redis ====================
# Redis connection (session cache, entity buffer)
REDIS_URL=redis://localhost:6379/0

# ==================== MQTT ====================
# MQTT broker for vehicle communication
MQTT_BROKER=localhost
MQTT_PORT=1883

# ==================== LLM Configuration ====================
# OpenAI-compatible API (DashScope/Qwen)
# Used for both planning (qwen-turbo) and memory extraction
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Default LLM model for planning
LLM_DEFAULT_MODEL=qwen-turbo
# Alternative env names (for compatibility)
# LLM_MODEL=qwen-turbo
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== P2 Memory Configuration ====================
# Memory extraction model (passive scoring + fact extraction + 10-class classification)
MEMORY_EXTRACT_MODEL=qwen-turbo

# Memory embedding model (vector search)
# USER LOCKED: text-embedding-v3
MEMORY_EMBED_MODEL=text-embedding-v3

# Embedding dimensions (MUST match PostgreSQL vector column dimension)
# USER LOCKED: Configure this based on text-embedding-v3 actual output
# - Research doc mentions 1024 for efficiency
# - OpenAI text-embedding-v3 defaults to 1536
# - Set explicitly to match your pgvector schema: vector(n)
# IMPORTANT: After changing this, run migration: python migrations/002_migrate_vector_to_1024.py
EMBEDDING_DIMENSIONS=1024

# Alternative env name (for compatibility)
# EMBEDDING_MODEL=text-embedding-v3

# ==================== RAG (Knowledge Base) ====================
# Used for manual queries (handbook search)
# If using different embedding for RAG, ensure pgvector schema matches
RAG_EMBED_MODEL=text-embedding-v3

# ==================== Agent Server ====================
# FastAPI server port
AGENT_PORT=8000

# ==================== Notes ====================
# 1. Embedding Dimensions Configuration:
#    - EMBEDDING_DIMENSIONS must match PostgreSQL vector column: vector(n)
#    - Default in this config: 1024
#    - If using 1536, update EMBEDDING_DIMENSIONS=1536 and run:
#      python migrations/001_create_p2_memory_table.py (for new DB)
#    - To migrate existing DB from 1536->1024 or vice versa:
#      python migrations/002_migrate_vector_to_1024.py (clears embeddings, alters schema)
#
# 2. Mock Data:
#    - Cloud production paths must NOT hardcode fake home addresses or coordinates
#    - Mock vehicle (testbench) may use fake coords internally
#    - Never write 0-dim placeholder vectors to database
#
# 3. NavGoal Contract:
#    - Cloud returns address_text only for home/company (no lat/lng)
#    - Vehicle performs geocoding and ACKs with nav_route_started
#
# 4. PII Safety:
#    - Chinese-safe regex patterns (no \b word boundaries)
#    - Blocks: mobile (1[3-9]\d{9}), ID card, bank card, passwords, medical records
#
# 5. Memory Isolation:
#    - user_id format: account_default:driver_xxx
#    - Each driver has isolated memory space
#    - Home/company addresses stored as content text only (no coordinates)
