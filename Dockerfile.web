FROM node:18-alpine AS builder

WORKDIR /app

# 复制package.json
COPY web/package.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY web/ ./

# 构建
RUN npm run build

# 生产镜像：使用nginx服务静态文件
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制nginx配置
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
